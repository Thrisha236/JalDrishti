# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- required for docker compose / production ---
POSTGRES_PASSWORD=change-me-long-and-random
# Token signing key. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JALRAKSHAK_SECRET=
# Password for the demo accounts, if you load the demo seed. A real deployment replaces the demo users.
JALRAKSHAK_DEMO_PASSWORD=
# Sensor node keys, as node:key pairs, one per node. Give every node its own long random key.
JALRAKSHAK_DEVICE_KEYS=node-a:replace-with-a-long-random-key,node-b:replace-with-another-long-random-key

# --- optional ---
# production (default in the container) refuses to start with demo settings. Use development on one machine.
JALRAKSHAK_ENV=production
# 1 turns on the demo conveniences (reset endpoint, scripted reports). Keep 0 anywhere real.
JALRAKSHAK_DEMO=0
# 1 loads the fictional demo village into an EMPTY database on first start. Use 0 for real data.
JALRAKSHAK_LOAD_SEED=1
# Allowed browser origins, comma separated.
JALRAKSHAK_CORS=http://localhost:8080
# Sensor readings older than this many days are deleted. 0 keeps everything.
JALRAKSHAK_READINGS_RETENTION_DAYS=30
# Requests per minute per client address (sensor ingestion gets 4x). 0 turns the limit off.
JALRAKSHAK_RATE_LIMIT=900
# Number of API worker processes.
JALRAKSHAK_WORKERS=2
